<resources>
  <!-- The window behind Compose and the core's SDL surface; Compose draws
       its own Material 3 theme (ui/theme/Theme.kt). -->
  <style name="Theme.HakuX" parent="android:Theme.Material.Light.NoActionBar">
    <item name="android:windowBackground">@android:color/white</item>
  </style>

  <!-- The game's windows (NativeCoreActivity, RelaunchActivity): black and
       full screen from the first frame, with no preview window or window
       animation, so a title's quick reboot into another of its XBEs doesn't
       show a white window or Android's transitions. Its parent is the
       in-game dialogs' look: light, or dark (Theme.HakuX.Game.Dark, set by
       NativeCoreActivity when the app's theme is). -->
  <style name="Theme.HakuX.Game" parent="android:Theme.Material.Light.NoActionBar.Fullscreen">
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:windowDisablePreview">true</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    <item name="android:colorPrimary">@color/hakux_green</item>
    <item name="android:colorAccent">@color/hakux_green</item>
  </style>
  <style name="Theme.HakuX.Game.Dark" parent="android:Theme.Material.NoActionBar.Fullscreen">
    <item name="android:windowBackground">@android:color/black</item>
    <item name="android:windowDisablePreview">true</item>
    <item name="android:windowAnimationStyle">@null</item>
    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    <item name="android:colorPrimary">@color/hakux_green_dark</item>
    <item name="android:colorAccent">@color/hakux_green_dark</item>
  </style>

  <!-- The clock's date and time pickers (Settings → Console → Clock), light
       or dark as the app is, in its green. -->
  <style name="Theme.HakuX.Picker" parent="android:Theme.Material.Light.Dialog">
    <item name="android:colorPrimary">@color/hakux_green</item>
    <item name="android:colorAccent">@color/hakux_green</item>
  </style>
  <style name="Theme.HakuX.Picker.Dark" parent="android:Theme.Material.Dialog">
    <item name="android:colorPrimary">@color/hakux_green_dark</item>
    <item name="android:colorAccent">@color/hakux_green_dark</item>
  </style>
</resources>
