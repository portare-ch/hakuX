diff --git a/src/hook/kgsl_context_hook.c b/src/hook/kgsl_context_hook.c
new file mode 100644
index 0000000..5d46a50
--- /dev/null
+++ b/src/hook/kgsl_context_hook.c
@@ -0,0 +1,10 @@
+#include <stdarg.h>
+#include "hook_impl.h"
+
+__attribute__((visibility("default"))) int ioctl(int fd, int request, ...) {
+	va_list args;
+	va_start(args, request);
+	void *arg = va_arg(args, void *);
+	va_end(args);
+	return hook_ioctl(fd, request, arg);
+}
